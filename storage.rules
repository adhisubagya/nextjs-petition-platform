rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Each signer may add images only under their own uid (custom-token sign-in, ADR 0003).
    match /avatars/{uid}/{file} {
      allow read: if true;
      // Compressed client-side to ~50KB WebP; raster images only (no SVG), from email-code signers only.
      allow create: if request.auth != null
                    && request.auth.token.signer == true
                    && request.auth.uid == uid
                    && request.resource.size < 200 * 1024
                    && request.resource.contentType.matches('image/(webp|png|jpeg)');
      allow update, delete: if false;
    }
  }
}
