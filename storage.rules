rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Each signer may add images only under their own uid (custom-token sign-in, ADR 0003).
    match /avatars/{uid}/{file} {
      allow read: if true;
      // Compressed client-side to ~50KB; reject anything that is not a small image.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.size < 200 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
  }
}
