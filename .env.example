# Demo Mode: writes are intercepted and admin controls are read-only. Set to "false" for a live deployment.
NEXT_PUBLIC_DEMO_MODE=true
PETITION_ID=default
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase web app (public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Firebase Admin (server only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudflare Turnstile (these are Cloudflare's always-pass test keys; replace in production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Upstash Redis for rate limiting (3 comments per IP per minute)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
