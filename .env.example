# Demo Mode: writes are intercepted and admin controls are read-only. Set to "false" for a live deployment.
NEXT_PUBLIC_DEMO_MODE=true
PETITION_ID=default
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase web app (public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Firebase Admin (server only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudflare Turnstile (these are Cloudflare's always-pass test keys; replace in production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Upstash Redis for rate limiting (3 comments per IP per minute)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated emails allowed into /admin (Firebase Auth users)
ADMIN_EMAILS=admin@demo.com

# PostHog: browser key for tracking; personal API key (server only) for the dashboard. Unset = sample data.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=

# Email-code sign-in (live mode only; Demo Mode shows the code on screen and needs none of these)
# OTP_HMAC_SECRET=          # 32+ random bytes, e.g. `openssl rand -base64 32`
# EMAIL_FROM=               # verified sender, e.g. no-reply@mail.yourdomain.com
# EMAIL_FROM_NAME=Petition
# Providers are tried in this order; set any subset. Daily caps: Brevo 300, Resend 100, Mailjet 200.
# BREVO_API_KEY=
# RESEND_API_KEY=
# MAILJET_API_KEY=
# MAILJET_SECRET_KEY=
